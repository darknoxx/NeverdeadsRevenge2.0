# The virtualenv is built per machine, never committed.
.venv/
# PyInstaller's working tree, the frozen builds, and the AppImage tool the Linux
# build downloads: produced, never committed.
build/
dist/
# The Android toolchain's working directory and what it produces. Ignored on
# every branch, because a clone that happens to have built an APK is still a
# clone -- and the build tree is gigabytes of somebody else's source.
.venv-android/
.buildozer/
bin/
*.apk

# Bytecode.
__pycache__/
*.py[cod]

# A clone starts with nothing: no scores, no run in progress, no backup.
meta.json
meta.json.bak
run.json

# Editor and OS noise.
*.swp
.DS_Store
