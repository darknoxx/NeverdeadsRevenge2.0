# The virtualenv is built per machine, never committed.
.venv/
.venv-android/

# Bytecode.
__pycache__/
*.py[cod]

# A clone starts with nothing: no scores, no run in progress, no backup.
meta.json
meta.json.bak
run.json

# Editor and OS noise.
*.swp
.DS_Store

# Android: the toolchain's own working directory and the APKs it produces. Both
# are built, both are large (the SDK and NDK alone are gigabytes), and neither
# belongs in a clone -- `packaging/android/README.md` says how to make them.
.buildozer/
bin/
*.apk
*.keystore
