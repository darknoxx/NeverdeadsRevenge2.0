#!/usr/bin/env bash
# Launcher for the game. ``ndr2`` is the same door; this one is the name a
# keyboard remembers from the session the second front end was built in.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python="$here/.venv/bin/python"

if [[ ! -x "$python" ]]; then
    echo "No virtualenv found. Run:" >&2
    echo "  ./install.sh --sdl" >&2
    exit 1
fi

# pygame is a dependency of the game now, so a venv without it is a venv that was
# built before it was -- and a ModuleNotFoundError from three files down is a poor
# way to find that out. Say it here instead.
if ! "$python" -c "import pygame" 2>/dev/null; then
    echo "The window needs pygame-ce, which this virtualenv does not have:" >&2
    echo "  ./.venv/bin/pip install -e ." >&2
    echo "or re-run  ./install.sh" >&2
    exit 1
fi

exec "$python" -m neverdeads_revenge "$@"
